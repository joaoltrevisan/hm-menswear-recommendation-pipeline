# Source this trusted local file explicitly; the application never auto-loads .env.
# Use local sockets or TLS-verified connections outside an isolated local container.
HM_RAW_DIR=../hm-menswear-data/raw
HM_WORK_DIR=../hm-menswear-work
HM_CHUNK_SIZE=100000
# Supply DSNs locally, preferably via libpq service/pass files. Never commit secrets.
HM_DATABASE_DSN='service=hm_loader'
HM_MIGRATION_DSN='service=hm_migrator'
HM_ADMIN_DSN='service=hm_admin'
HM_MODEL_DSN='service=hm_model'
HM_READER_DSN='service=hm_reader'
# Compose only: path to a private, owner-readable file containing a strong password.
HM_PG_PASSWORD_FILE=../hm-menswear-work/secrets/postgres-password
HM_PG_PORT=55432
# Set HM_TEST_ADMIN_DSN only when running integration tests on an isolated server.
